{:source-paths
 ["src"
  "test"
  ;; Sibling checkouts in the west layout (orgs/kotoba-lang/<repo>). The same
  ;; wiring protocols-worker used, minus its own src — this library IS the
  ;; part that was shared.
  "../kotobase/src"
  "../kotobase-peer/src"
  "../kotobase-block-codec/src"
  "../org-ietf-deflate/src"
  "../kotobase-projection/src"
  "../kotobase-client/src"
  "../kotobase-protocol-core/src"
  ;; test-only: snapshot-seed-round-trip drives the persistence model through
  ;; a real surface, and core carries no built-in surface table.
  "../kotobase-protocol-s3/src"
  "../kotobase-protocol-ipfs/src"
  "../kotobase-protocol-atproto/src"
  "../kotobase-protocol-git/src"
  "../kotobase-protocol-pinning/src"
  "../kotobase-protocol-issues/src"
  "../kotobase-query/src"
  "../datom/src"
  "../datom-source/src"
  "../datalog/src"
  "../arrangement/src"
  "../prolly-tree/src"
  "../chain/src"
  "../sigv4/src"
  ;; The Biscuit rung of the credential ladder (ADR-2608291700 order 1).
  ;; `kotobase.biscuit-grant` is NOT copied here: it is the one implementation
  ;; authn mints through and the API gateway verifies through (ADR-2608262600
  ;; D4), and a copy would be a second answer to drift away from the first.
  ;; The path reaches across to net-kotobase because that is where the shared
  ;; namespace lives today; this library exists to serve those Workers, which
  ;; is the direction `net-kotobase/cypher` already depends on. Extracting it
  ;; to a kotoba-lang home would remove the reach -- recorded as follow-up
  ;; rather than done here, because it moves three repos' pins.
  "../../net-kotobase/control-plane/shared/src"
  "../authority/src"
  "../org-biscuitsec/src"
  ;; biscuit/wire.cljc requires protobuf.wire.
  "../dev-protobuf/src"
  ;; multiformats/core.cljc requires sha2.core. Unrelated to Biscuit: main
  ;; could not be rebuilt against the current manifest pins without it, the
  ;; same repair protocols-worker needed on 2026-08-31.
  "../org-nist-sha2/src"
  "../io-ipld/src"
  "../io-multiformats/src"
  "../org-ietf-cbor/src"
  "../graphql/src"
  "../sparql/src"
  "../org-w3-sparql-protocol/src"
  "../org-opencypher-cypher/src"
  "../org-apache-tinkerpop-gremlin/src"
  "../org-graphql-http/src"]

 :dependencies []

 :builds
 {:test {:target :node-test
         :output-to "out/node-tests.js"
         :ns-regexp "-test$"
         :compiler-options {:parallel-build false}}
  ;; One namespace, for a fast verdict. The full suite DOES finish -- it takes
  ;; about nine minutes on a loaded workstation, and the earlier claim in this
  ;; comment that it "never completes" was wrong.
  ;;
  ;; The error is worth keeping, because it cost something. The suite was killed
  ;; at a 900s cap three times and the silence was read as a hang; nobody looked
  ;; at whether the process was burning CPU. It was: CPU time climbed 8s -> 28s
  ;; -> 75s -> 89s across samples, which is a slow test, not a deadlock. Acting
  ;; on the wrong reading, the Biscuit rung was merged and deployed without the
  ;; suite ever having finished, and it had broken one assertion --
  ;; `an-anonymous-gremlin-websocket-handshake-is-rejected` still expected
  ;; www-authenticate "Bearer". A run to completion would have said so in nine
  ;; minutes.
  ;;
  ;; So: NOT a substitute for the full suite. Use it for a quick answer on this
  ;; one namespace and still run `compile test` before landing. What the wider
  ;; suite needs is the treatment protocols-worker gives its own heavy work --
  ;; the multi-thousand-commit tests moved to their own build, out of the
  ;; default `-test$` set -- and that is not done here.
  ;;
  ;; Unrelated, also measured: this repo's main could not be COMPILED against
  ;; the current manifest pins until the org-nist-sha2 source path above was
  ;; added, so nothing here had been built for some time.
  :biscuit-test {:target :node-test
                 :output-to "out/biscuit-tests.js"
                 :ns-regexp "biscuit-test$"
                 :compiler-options {:parallel-build false}}
  ;; The two store scenarios measured in MINUTES, held out of the default
  ;; `-test$` set. Measured 2026-08-31: kotobase-store-test alone ran 829s for
  ;; 9 tests, essentially the whole cost of the suite. Same treatment
  ;; protocols-worker gives fold-bench / hydrate-phase-bench / query-bench.
  ;;
  ;; Held out, NOT retired: run it before landing anything that touches the
  ;; store. `npx shadow-cljs compile store-heavy && node out/store-heavy.js`.
  :store-heavy {:target :node-test
                :output-to "out/store-heavy.js"
                :ns-regexp "kotobase-store-heavy$"
                :compiler-options {:parallel-build false}}}}
